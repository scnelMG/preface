# 이 파일을 .env.local로 복사해서 쓴다. 실제 값이 담기는 .env.local은 커밋되지 않는다(.gitignore).
# NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저 번들에 그대로 들어간다.
# 토큰·비밀키를 여기에 넣지 않는다.

# 외부 API. 명세서 v2.7 "0. 공통 규칙" — BE-Spring만 외부에 노출한다
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 정적 자산(기본 모델 메시, 공개 샘플 머리 3종) 주소. 비우면 /public을 쓴다
NEXT_PUBLIC_ASSET_BASE_URL=
