{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preface.local/contracts/frame-extraction/lens.schema.json",
  "title": "Lens (프레임 묶음 렌즈 정보)",
  "description": "추출 워커가 원본 영상 메타에서 읽은 렌즈 정보. 묶음 안 lens.json과 같은 값이다. 계약에는 GPU가 쓰는 focalPx·focalSource만 필수이고, 나머지 키(focal35mm, deviceMake, deviceModel, lensModel, deviceProfile, imageWidth, imageHeight)는 있으면 그대로 전달한다. Spring은 해석하지 않고 저장·전달만 한다. 위치(GPS)는 넣지 않는다.",
  "type": "object",
  "required": [
    "focalPx",
    "focalSource"
  ],
  "properties": {
    "focalPx": {
      "description": "GPU가 쓸 초점 거리(픽셀). 알 수 없으면 null",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "focalSource": {
      "description": "focalPx 출처: 이 영상 파일 메타 / 같은 기종의 다른 영상 파일 메타 / 기종 프로필 / 없음",
      "type": "string",
      "enum": [
        "file",
        "same-model file",
        "device profile",
        "none"
      ]
    },
    "focal35mm": {
      "type": [
        "number",
        "null"
      ]
    },
    "deviceMake": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "deviceModel": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "lensModel": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "deviceProfile": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "imageWidth": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "imageHeight": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  },
  "additionalProperties": true
}
