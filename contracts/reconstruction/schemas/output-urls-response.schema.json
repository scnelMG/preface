{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preface.local/contracts/reconstruction/output-urls-response.schema.json",
  "title": "OutputUploadUrls (INT-REC-04 응답 data)",
  "description": "결과 객체 업로드용 presigned PUT(만료 10분). 올리기 직전에 요청한다. 워커는 S3 자격 증명을 갖지 않는다. 쓰지 않는 항목(예: GLB에 텍스처 내장)은 올리지 않고 결과 보고에서 생략한다. 설문용 얼굴 사진 5방향(captures)도 같이 준다(v2.9).",
  "type": "object",
  "required": [
    "mesh",
    "texture",
    "thumbnail",
    "captures"
  ],
  "properties": {
    "mesh": {
      "$ref": "#/$defs/upload"
    },
    "rig": {
      "description": "선택적 코 편집 리그 JSON 업로드 URL. 생성·무결성 검사를 통과한 리그만 업로드하며 이것만으로 편집 허용을 선언하지 않는다",
      "$ref": "#/$defs/upload"
    },
    "expression": {
      "description": "선택적 표정 트래킹 리그 JSON(expression.json) 업로드 URL(S15P31B204-879). 이 항목이 있을 때만 워커가 업로드할 최종 메시·리그로 표정 리그를 만들어 올린다. rig.json은 코·눈 승인이 파일 해시로 묶여 있어 따로 둔다",
      "$ref": "#/$defs/upload"
    },
    "texture": {
      "$ref": "#/$defs/upload"
    },
    "thumbnail": {
      "$ref": "#/$defs/upload"
    },
    "captures": {
      "description": "5방향 얼굴 사진(JPEG) 업로드 URL. 촬영 영상에서 각 방향을 가장 잘 보여 주는 프레임 1장씩. 성공 결과에는 5장 모두 필수(v2.9, S15P31B204-301)",
      "type": "object",
      "required": [
        "FRONT",
        "LEFT",
        "RIGHT",
        "LEFT_45",
        "RIGHT_45"
      ],
      "properties": {
        "FRONT": {
          "$ref": "#/$defs/upload"
        },
        "LEFT": {
          "$ref": "#/$defs/upload"
        },
        "RIGHT": {
          "$ref": "#/$defs/upload"
        },
        "LEFT_45": {
          "$ref": "#/$defs/upload"
        },
        "RIGHT_45": {
          "$ref": "#/$defs/upload"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "upload": {
      "type": "object",
      "required": [
        "objectKey",
        "uploadUrl",
        "method",
        "headers",
        "expiresAt"
      ],
      "properties": {
        "objectKey": {
          "description": "결과 보고(INT-REC-03)에 그대로 넣는 key",
          "type": "string",
          "pattern": "^users/[0-9a-f-]{36}/models/[0-9a-f-]{36}/[A-Za-z0-9._/-]+$"
        },
        "uploadUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "method": {
          "const": "PUT"
        },
        "headers": {
          "description": "PUT 요청에 그대로 붙일 헤더(서명에 포함됨)",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
